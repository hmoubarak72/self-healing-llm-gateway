GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO
GATEWAY_ENVIRONMENT=production
ADMIN_API_KEY=change-me-super-secret-admin-key
MOCK_PROVIDERS_ENABLED=true

REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=llmgw

OPENAI_API_KEY=sk-mock-openai-key
ANTHROPIC_API_KEY=sk-ant-mock-anthropic-key
GEMINI_API_KEY=mock-gemini-api-key
AWS_ACCESS_KEY_ID=mock-aws-key
AWS_SECRET_ACCESS_KEY=mock-aws-secret
AWS_REGION_NAME=us-east-1

TELEMETRY_WINDOW_SECONDS=60
TELEMETRY_BUCKET_SECONDS=5

CB_MIN_SAMPLE_SIZE=5
CB_ERROR_RATE_THRESHOLD=0.5
CB_P95_LATENCY_THRESHOLD_MS=2500
CB_OPEN_DURATION_SECONDS=20
CB_HALF_OPEN_CANARY_RATE=0.10
CB_REQUIRED_SUCCESSES_TO_CLOSE=3
CB_REQUIRED_FAILURES_TO_REOPEN=1

QUEUE_MAX_RETRIES=5
QUEUE_BASE_BACKOFF_SECONDS=1.0
QUEUE_MAX_BACKOFF_SECONDS=30.0
QUEUE_DEADLINE_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_LOCK_TTL_SECONDS=30

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
